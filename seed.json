{
  "_meta": {
    "kit": "0.1",
    "matches": "Prototype/GYS_Coach_Platform_Rig_v0.3.html",
    "date": "2026-10-16",
    "purpose": "Synthetic starting data only: reference lists and placeholder settings. No people, no organisations, no contact details, no money figures.",
    "loads_into": "schema.sql tables named in each section's _table key",
    "settings_note": "Non-money settings carry the rule as agreed in the rig so the server has a working default; every value is changed in G4 with a reason. Every money setting is null until Finance admin sets it. Settings marked open are null."
  },

  "roles": {
    "_table": "roles",
    "rows": [
      { "role": "admin",            "label": "Admin",                                  "may_open": "Everything except money: G0, G1 (no slab), G2, G3, G4 (non-money groups), G5, G6, G8, G9, G10" },
      { "role": "finance_admin",    "label": "Finance admin",                          "may_open": "Money and the roster: G1 slab, G4 money group, G6 tier rates, G7; read G0, G3, G5, G8, G9; own entries in the activity log" },
      { "role": "faculty",          "label": "Faculty",                                "may_open": "Their own batches, module versions they own, marking, Question Bank proposals (G2 faculty view)" },
      { "role": "mentor",           "label": "Mentor",                                 "may_open": "Their own mentees only (G2 mentor view)" },
      { "role": "coach_ours",       "label": "Coach — ours",                           "may_open": "Their own work: S1–S4, C1–C12" },
      { "role": "coach_org",        "label": "Coach — appointed by an organisation",   "may_open": "Their own work, for the appointing organisation's people only: S1–S4, C1–C12. Access ends when unassigned, when the engagement closes, or when they leave" },
      { "role": "aarambh_reviewer", "label": "Aarambh reviewer",                       "may_open": "Validation, leads and audit (A1–A3) only. Never G or C screens" }
    ]
  },

