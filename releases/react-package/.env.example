# Docker Compose configuration. For a manual Node deployment use backend/.env.example.
GYS_PUBLIC_SITE_URL=https://gyanisays.com
DOMAIN=gyanisays.com
GYS_ADMIN_USER=organiser
GYS_ADMIN_PASS=CHANGE_ME
GYS_DB_NAME=gyanisays
GYS_DB_USER=gyanisays
GYS_DB_PASS=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
GYS_SMTP_HOST=smtp.example.com
GYS_SMTP_PORT=587
GYS_SMTP_SECURE=tls
GYS_SMTP_USER=user@example.com
GYS_SMTP_PASS=CHANGE_ME
GYS_SMTP_FROM=no-reply@gyanisays.com
GYS_SMTP_FROM_NAME=GyaniSays
GYS_MAIL_TO=mandeep.sodhi@gyanisays.com
# HTTP-only Compose endpoint is local by default. Use HTTPS overlay for public traffic.
APP_BIND=127.0.0.1
APP_HTTP_PORT=8080
