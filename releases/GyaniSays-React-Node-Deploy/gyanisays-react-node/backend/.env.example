HOST=127.0.0.1
PORT=3000
GYS_DB_HOST=localhost
GYS_DB_PORT=3306
GYS_DB_NAME=gyanisays
GYS_DB_USER=CHANGE_ME
GYS_DB_PASS=CHANGE_ME
GYS_SMTP_HOST=smtp.example.com
GYS_SMTP_PORT=587
GYS_SMTP_SECURE=tls
GYS_SMTP_USER=user@example.com
GYS_SMTP_PASS=CHANGE_ME
GYS_SMTP_FROM=no-reply@gyanisays.com
GYS_SMTP_FROM_NAME=GyaniSays
GYS_MAIL_TO=mandeep.sodhi@gyanisays.com
GYS_ADMIN_USER=admin
GYS_ADMIN_PASS=CHANGE_ME
# Set to loopback only when a local reverse proxy replaces X-Forwarded-For.
TRUST_PROXY=false
# Set after deploying to the public domain. Used for the share link and QR.
# GYS_PUBLIC_SITE_URL=https://gyanisays.com
# Optional absolute path to the persistent event SQLite file (default data/events.sqlite).
# GYS_EVENT_DB=/var/lib/gyanisays/events.sqlite
