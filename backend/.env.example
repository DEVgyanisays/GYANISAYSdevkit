# Copy to .env locally. Never commit real credentials.
HOST=127.0.0.1
PORT=4174
PUBLIC_URL=http://127.0.0.1:4174
NODE_ENV=development
ADMIN_NAME=Mandeep sodhi
ADMIN_EMAIL=mandeep.sodhi@gyanisays.com
# A single-host SQLite file is used by this implementation. MySQL is not silently substituted.
DATA_DIR=./data
DATABASE_PATH=./data/saarthi.sqlite
# Required before binding a production server: HTTPS reverse proxy + initial setup token.
SETUP_TOKEN=
# Resend email transport. SMTP would require implementing a separate adapter.
RESEND_API_KEY=
EMAIL_FROM=
# Must be HTTPS in production; credentials exchanged with Aarambh's developer.
AARAMBH_BASE_URL=
AARAMBH_KEY_ID=
AARAMBH_SIGNING_SECRET=
# PDF coach-briefing API. Match this key with Aarambh GYANISAYS_API_KEY,
# this inbound secret with GYANISAYS_OUTBOUND_SECRET, and outbound with GYANISAYS_INBOUND_SECRET.
AARAMBH_GYANISAYS_BASE_URL=
AARAMBH_GYANISAYS_API_KEY=
AARAMBH_GYANISAYS_INBOUND_SECRET=
AARAMBH_GYANISAYS_OUTBOUND_SECRET=
# Disable transcript until legal approval and an actual transcription provider are configured.
TRANSCRIPTION_ENABLED=false

# Keep false on local/staging. Enable only after your production domain is configured.
SEARCH_INDEXING_ENABLED=false
# Deferred by owner; no tag loads while blank.
GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
# Local-only RAG. Ollama/model must exist on the hosting machine. No API key.
LOCAL_MODEL_URL=http://127.0.0.1:11434
LOCAL_MODEL=llama3.2:3b
