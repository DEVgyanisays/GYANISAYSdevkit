{
  "name": "saarthi-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/server.mjs",
    "backup": "node --env-file-if-exists=.env src/backup.mjs",
    "build": "node scripts/build.mjs",
    "test:rag-live": "node scripts/test-rag-live.mjs"
  }
}